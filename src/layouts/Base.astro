---
import '../styles/global.css';
import { company } from '../data/futurehitech';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = `${company.name} — Mechanical, Electrical & Plumbing | Dubai`,
  description = company.pitch,
  ogImage = '/og-image.jpg',
} = Astro.props;

// Resolve absolute URLs against the configured site (set in astro.config.mjs)
const siteUrl = Astro.site ?? new URL('https://gilded-alfajores-2c3f21.netlify.app');
const canonical = new URL(Astro.url.pathname, siteUrl).toString();
const ogImageAbs = new URL(ogImage, siteUrl).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16345D" />
    <meta name="format-detection" content="telephone=no" />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${company.name} — MEP Technical Services`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <!-- Structured data: Local business -->
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'GeneralContractor',
      name: company.legal,
      alternateName: company.name,
      description: company.pitch,
      url: siteUrl.toString(),
      logo: new URL('/img/brand/logo-dark.png', siteUrl).toString(),
      image: ogImageAbs,
      telephone: company.contact.phones,
      email: company.contact.emails[0],
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Office #1306, Saheel Tower 2, Al Nahda 1',
        addressLocality: 'Dubai',
        addressCountry: 'AE',
      },
      areaServed: 'AE',
      serviceType: ['Mechanical Systems', 'Electrical Systems', 'Plumbing Systems', 'Energy Efficiency', 'Project Management'],
    })} />
  </head>
  <body>
    <!-- Scroll progress bar — orange line at the top -->
    <div id="scroll-progress" aria-hidden="true"></div>

    <slot />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      import Lenis from '@studio-freight/lenis';

      gsap.registerPlugin(ScrollTrigger);

      // Smooth scroll
      const lenis = new Lenis({ duration: 1.1, smoothWheel: true });
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }
      requestAnimationFrame(raf);
      lenis.on('scroll', ScrollTrigger.update);

      // Reveal on scroll
      gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach((el) => {
        gsap.to(el, {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 85%' },
        });
      });

      gsap.utils.toArray<HTMLElement>('[data-stagger]').forEach((wrap) => {
        const kids = wrap.querySelectorAll<HTMLElement>(':scope > *');
        gsap.to(kids, {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          stagger: 0.08,
          scrollTrigger: { trigger: wrap, start: 'top 85%' },
        });
      });

      // Counter animation
      gsap.utils.toArray<HTMLElement>('[data-counter]').forEach((el) => {
        const end = Number(el.dataset.counter || '0');
        const obj = { v: 0 };
        gsap.to(obj, {
          v: end,
          duration: 1.6,
          ease: 'power2.out',
          scrollTrigger: { trigger: el, start: 'top 85%' },
          onUpdate: () => { el.textContent = Math.round(obj.v).toString(); },
        });
      });

      // ----------------------------------------------------------------------
      // PREMIUM EFFECTS — all respect prefers-reduced-motion.
      // ----------------------------------------------------------------------
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // (1) Scroll progress bar — scaleX from 0 → 1 across the page.
      const progressBar = document.getElementById('scroll-progress');
      if (progressBar && !reduceMotion) {
        const updateProgress = () => {
          const doc = document.documentElement;
          const max = doc.scrollHeight - window.innerHeight;
          const ratio = max > 0 ? Math.min(window.scrollY / max, 1) : 0;
          progressBar.style.transform = `scaleX(${ratio})`;
        };
        updateProgress();
        window.addEventListener('scroll', updateProgress, { passive: true });
        window.addEventListener('resize', updateProgress);
      }

      // (2) Hero word cycler — rotate through brand adjectives every ~2.4s.
      const heroWord = document.getElementById('hero-word');
      if (heroWord && !reduceMotion) {
        const words = ['sustainable', 'energy-efficient', 'future-ready', 'climate-smart'];
        let idx = 0;
        setInterval(() => {
          heroWord.classList.add('is-swapping');
          setTimeout(() => {
            idx = (idx + 1) % words.length;
            heroWord.textContent = words[idx];
            heroWord.classList.remove('is-swapping');
          }, 320);
        }, 2400);
      }

      // (3) Cursor spotlight — soft brand glow follows the mouse on .cursor-spotlight sections.
      if (!reduceMotion && window.matchMedia('(hover: hover)').matches) {
        document.querySelectorAll<HTMLElement>('.cursor-spotlight').forEach((section) => {
          section.addEventListener('mouseenter', () => section.classList.add('is-active'));
          section.addEventListener('mouseleave', () => section.classList.remove('is-active'));
          section.addEventListener('mousemove', (e) => {
            const rect = section.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;
            section.style.setProperty('--mx', `${x}%`);
            section.style.setProperty('--my', `${y}%`);
          });
        });
      }

      // (4) Continuous shine on [data-shine] — driven entirely by CSS now,
      //     no JS needed. Kept here as a comment for discoverability.

      // (5) Magnetic buttons — gentle pull toward cursor on [data-magnetic].
      if (!reduceMotion && window.matchMedia('(hover: hover)').matches) {
        const PULL = 0.28; // 0..1, fraction of distance to follow
        document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((btn) => {
          const parent = btn; // listen on the button itself
          parent.addEventListener('mousemove', (e) => {
            const rect = btn.getBoundingClientRect();
            const cx = rect.left + rect.width / 2;
            const cy = rect.top + rect.height / 2;
            const dx = (e.clientX - cx) * PULL;
            const dy = (e.clientY - cy) * PULL;
            btn.style.transform = `translate(${dx}px, ${dy}px)`;
          });
          parent.addEventListener('mouseleave', () => {
            btn.style.transform = '';
          });
        });
      }

      // Safety net: if the GSAP reveal animations haven't fired for any reason
      // (very fast scroll, Lenis/ScrollTrigger sync hiccup, etc.) any element
      // still at near-zero opacity after 6s gets forcibly revealed so the user
      // never sees a permanently blank section.
      setTimeout(() => {
        document.querySelectorAll<HTMLElement>('[data-reveal], [data-stagger] > *').forEach((el) => {
          if (parseFloat(getComputedStyle(el).opacity) < 0.1) {
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          }
        });
      }, 6000);

      // Nav state-awareness — transparent over the hero, solid white frosted
      // once the user has scrolled past it. Driven by IntersectionObserver
      // so the threshold matches the *actual* hero size on any viewport.
      const nav = document.querySelector<HTMLElement>('[data-nav]');
      const hero = document.querySelector<HTMLElement>('#top');
      const SCROLLED_CLASSES = ['shadow-lg', 'bg-white/95', 'backdrop-blur', 'is-scrolled'] as const;

      if (nav) {
        const setScrolled = (on: boolean) => {
          if (on) nav.classList.add(...SCROLLED_CLASSES);
          else    nav.classList.remove(...SCROLLED_CLASSES);
        };

        if (hero && 'IntersectionObserver' in window) {
          const heroObserver = new IntersectionObserver(
            ([entry]) => setScrolled(!entry.isIntersecting),
            // Trigger slightly before the hero fully exits so the swap
            // happens as the nav crosses out of the orange band.
            { rootMargin: '-64px 0px 0px 0px' }
          );
          heroObserver.observe(hero);
        } else {
          // Fallback: switch after one viewport of scroll
          const update = () => setScrolled(window.scrollY > window.innerHeight * 0.8);
          update();
          window.addEventListener('scroll', update, { passive: true });
        }
      }
    </script>
  </body>
</html>

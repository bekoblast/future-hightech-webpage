---
// Lightweight outline icon set — viewBox 24×24, currentColor stroke.
// Usage: <Icon name="bolt" class="w-6 h-6 text-orange-500" />
interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}
const { name, class: cls = 'w-6 h-6', strokeWidth = 1.6 } = Astro.props;
const sw = strokeWidth;
---
{name === 'fan' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="2" />
    <path d="M12 10V4a4 4 0 0 1 4 4" />
    <path d="M14 12h6a4 4 0 0 1-4 4" />
    <path d="M12 14v6a4 4 0 0 1-4-4" />
    <path d="M10 12H4a4 4 0 0 1 4-4" />
  </svg>
)}
{name === 'bolt' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round">
    <path d="M13 2L4 14h7l-2 8 9-12h-7l2-8z" />
  </svg>
)}
{name === 'droplet' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round">
    <path d="M12 2.5C9 6.5 5 11 5 14.5a7 7 0 0 0 14 0c0-3.5-4-8-7-12z" />
    <path d="M9 14.5a3 3 0 0 0 3 3" />
  </svg>
)}
{name === 'leaf' && (
  <svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={sw} stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 20c4-6 8-10 17-11 1 6-3 13-11 13a7 7 0 0 1-6-2z" />

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {
  company, mission, vision, aboutUs,
  services, approach, whyUs, sectors, projects,
} from '../data/futurehitech';

const navLinks = [
  { href: '#about', label: 'About' },
  { href: '#services', label: 'Services' },
  { href: '#approach', label: 'Approach' },
  { href: '#sectors', label: 'Sectors' },
  { href: '#projects', label: 'Projects' },
  { href: '#contact', label: 'Contact' },
];
---
<Base>
  <!-- =========================== NAV =========================== -->
  <header data-nav class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
    <div class="container-x flex items-center justify-between py-4">
      <!-- Logo: two stacked variants swap based on nav state -->
      <a href="#top" class="relative flex items-center" aria-label="Future Hitech home">
        <img src="/img/brand/logo-hero.png" alt="Future Hitech" class="nav-logo-light h-7 md:h-8 w-auto" />
        <img src="/img/brand/logo-dark.png"  alt=""               aria-hidden="true" class="nav-logo-dark absolute inset-0 h-7 md:h-8 w-auto" />
      </a>

      <nav class="hidden md:flex items-center gap-4 lg:gap-8 text-xs lg:text-sm font-medium">
        {navLinks.map(l => (
          <a href={l.href} class="nav-link whitespace-nowrap">{l.label}</a>
        ))}
      </nav>

      <a
        href="#contact"
        data-magnetic
        class="hidden md:inline-flex items-center gap-2 whitespace-nowrap rounded-full bg-orange-500 px-4 lg:px-5 py-2 lg:py-2.5 text-xs lg:text-sm font-semibold text-white shadow-glow-orange hover:bg-orange-600 transition-colors"
      >
        <span class="hidden lg:inline">Request a </span>Quote
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5-5 5M6 12h12"/></svg>
      </a>
      <a href="#contact" class="md:hidden nav-cta-mobile font-semibold text-sm">Quote</a>
    </div>
  </header>

  <!-- =========================== HERO =========================== -->
  <section id="top" class="relative min-h-screen flex items-center bg-hero-gradient text-white overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-30"></div>
    <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-orange-500/30 blur-3xl"></div>
    <div class="absolute -bottom-40 -left-20 w-[500px] h-[500px] rounded-full bg-navy-900/40 blur-3xl"></div>

    <div class="container-x relative pt-28 pb-12 md:pt-32 md:pb-20 grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-7" data-reveal>
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 backdrop-blur px-4 py-1.5 text-xs font-medium tracking-wider uppercase ring-1 ring-white/20 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-orange-300 animate-pulse"></span>
          MEP Technical Services · Dubai – UAE
        </div>
        <h1 class="font-display text-5xl md:text-6xl lg:text-7xl font-extrabold leading-[1.05] tracking-tight text-balance">
          Engineering safer, smarter, more <span id="hero-word" class="text-orange-300">sustainable</span> buildings.
        </h1>
        <p class="mt-6 max-w-2xl text-lg md:text-xl text-white/85 text-pretty">
          {company.pitch}
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="#services" data-magnetic class="inline-flex items-center gap-2 rounded-full bg-white text-navy-900 px-6 py-3 font-semibold hover:bg-orange-50 transition-colors">
            Explore our services
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5-5 5M6 12h12"/></svg>
          </a>
          <a href="#contact" data-magnetic class="inline-flex items-center gap-2 rounded-full ring-2 ring-white/40 px-6 py-3 font-semibold text-white hover:bg-white/10 transition-colors">
            Talk to an engineer
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 relative pb-16 lg:pb-20" data-reveal>
        <!-- Bento photo collage showing breadth of work -->
        <div class="grid grid-cols-2 grid-rows-3 gap-3 aspect-[4/5] rounded-3xl">
          <!-- Big tall left: engineers + blueprints (design phase) -->
          <div class="row-span-2 brand-border-3 relative rounded-2xl overflow-hidden shadow-2xl group">
            <img src="/img/stock/team-blueprints.jpg" alt="Future Hitech engineers reviewing project plans" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" loading="eager"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/70 via-transparent"></div>
            <div class="absolute bottom-3 left-3 right-3">
              <div class="inline-flex items-center gap-1.5 rounded-full bg-orange-500 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white">
                <span class="w-1 h-1 rounded-full bg-white"></span>
                Design
              </div>
            </div>
          </div>

          <!-- Top right: villa exterior (scale) -->
          <div class="brand-border relative rounded-2xl overflow-hidden shadow-xl group">
            <img src="/img/projects/p13.jpeg" alt="Modern villa exterior" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="eager"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/60 via-transparent"></div>
            <div class="absolute bottom-2 left-2 rounded-full bg-navy-900/80 backdrop-blur px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-orange-300">Build</div>
          </div>

          <!-- Middle right: electrical work (craft) -->
          <div class="brand-border relative rounded-2xl overflow-hidden shadow-xl group">
            <img src="/img/stock/electrician-cables.jpg" alt="Electrical panel installation" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="eager"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/60 via-transparent"></div>
            <div class="absolute bottom-2 left-2 rounded-full bg-navy-900/80 backdrop-blur px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-orange-300">Install</div>
          </div>

          <!-- Bottom left: luxury marble staircase (electrical + finish) -->
          <div class="brand-border relative rounded-2xl overflow-hidden shadow-xl group">
            <img src="/img/projects/p07.jpeg" alt="Luxury marble staircase with LED lighting" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="eager"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/60 via-transparent"></div>
            <div class="absolute bottom-2 left-2 rounded-full bg-navy-900/80 backdrop-blur px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-orange-300">Lighting</div>
          </div>

          <!-- Bottom right: modern kitchen (residential MEP) -->
          <div class="brand-border relative rounded-2xl overflow-hidden shadow-xl group">
            <img src="/img/projects/p06.jpeg" alt="Modern residential kitchen with integrated MEP" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="eager"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/60 via-transparent"></div>
            <div class="absolute bottom-2 left-2 rounded-full bg-navy-900/80 backdrop-blur px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider text-orange-300">Finish</div>
          </div>
        </div>

        <!-- Floating stats sticker -->
        <div class="absolute -bottom-2 left-4 right-4 lg:left-2 lg:right-2 bg-navy-900/95 backdrop-blur-xl rounded-2xl px-5 py-4 shadow-2xl ring-1 ring-white/15">
          <div class="grid grid-cols-3 gap-2 text-center">
            <div>
              <div class="text-2xl md:text-3xl font-extrabold font-display text-white">+<span data-counter={company.experienceYears}>0</span></div>
              <div class="text-[9px] text-white/60 mt-0.5 uppercase tracking-wider">Years</div>
            </div>
            <div class="border-x border-white/10">
              <div class="text-2xl md:text-3xl font-extrabold font-display text-white">+<span data-counter={company.projectsExecuted}>0</span></div>
              <div class="text-[9px] text-white/60 mt-0.5 uppercase tracking-wider">Projects</div>
            </div>
            <div>
              <div class="text-2xl md:text-3xl font-extrabold font-display text-orange-400">+<span data-counter={company.satisfiedCustomers}>0</span></div>
              <div class="text-[9px] text-white/60 mt-0.5 uppercase tracking-wider">Customers</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================== ABOUT =========================== -->
  <section id="about" class="py-16 md:py-32 bg-white">
    <div class="container-x grid lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-5" data-reveal>
        <div class="text-xs uppercase tracking-[0.25em] text-orange-500 font-semibold">About Us</div>
        <h2 class="font-display text-4xl md:text-5xl font-extrabold text-navy-900 mt-3 leading-tight text-balance">
          A leading provider of comprehensive MEP services.
        </h2>
        <div class="mt-8 brand-border-3 relative aspect-[4/5] rounded-3xl overflow-hidden">
          <img src="/img/stock/engineer-plans.jpg" alt="Engineer reviewing project plans" class="absolute inset-0 w-full h-full object-cover" loading="lazy"/>
          <div class="absolute inset-0 bg-gradient-to-tr from-navy-900/60 via-transparent to-orange-500/15"></div>
          <div class="absolute bottom-5 left-5 right-5">
            <div class="inline-flex items-center gap-2 rounded-full bg-orange-500 text-white px-3 py-1 text-xs font-bold uppercase tracking-wider">
              <span class="w-1.5 h-1.5 rounded-full bg-white"></span>
              Design · Install · Maintain
            </div>
          </div>
        </div>
      </div>
      <div class="lg:col-span-7 lg:pt-4" data-reveal>
        <p class="text-navy-700 text-lg leading-relaxed text-pretty">
          {aboutUs}
        </p>
        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="rounded-2xl border border-navy-100 bg-navy-50/50 p-6">
            <div class="text-orange-500 text-xs font-semibold uppercase tracking-wider">Mission</div>
            <p class="mt-3 text-navy-800 text-sm leading-relaxed">{mission}</p>
          </div>
          <div class="rounded-2xl border border-orange-100 bg-orange-50/50 p-6">
            <div class="text-orange-500 text-xs font-semibold uppercase tracking-wider">Vision</div>
            <p class="mt-3 text-navy-800 text-sm leading-relaxed">{vision}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================== SERVICES =========================== -->
  <section id="services" class="cursor-spotlight py-16 md:py-32 bg-navy-900 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-grid opacity-20"></div>
    <div class="absolute -top-40 right-0 w-[500px] h-[500px] rounded-full bg-orange-500/15 blur-3xl"></div>

    <div class="container-x relative">
      <div class="max-w-3xl" data-reveal>
        <div class="text-xs uppercase tracking-[0.25em] text-orange-400 font-semibold">Core Services</div>
        <h2 class="font-display text-4xl md:text-5xl font-extrabold mt-3 leading-tight text-balance">
          Five integrated practices. <span class="text-orange-400">One turnkey partner.</span>
        </h2>
        <p class="mt-5 text-white/70 text-lg">From design to installation to long-term maintenance — we deliver every layer of the MEP stack.</p>
      </div>

      <div class="mt-10 md:mt-16 grid md:grid-cols-2 lg:grid-cols-3 gap-6" data-stagger>
        {services.map(svc => (
          <article data-shine class="group brand-border relative rounded-3xl bg-white/[0.04] hover:bg-white/[0.08] p-7 transition-all duration-300">
            <div class="flex items-start justify-between mb-6">
              <div class="text-5xl font-display font-extrabold text-orange-500/90">{svc.number}</div>
              <div class="w-12 h-12 rounded-xl bg-orange-500/10 ring-1 ring-orange-400/30 flex items-center justify-center text-orange-400 group-hover:bg-orange-500 group-hover:text-white transition-colors duration-300">
                <Icon name={svc.icon} class="w-6 h-6" />
              </div>
            </div>
            <h3 class="font-display text-2xl font-bold leading-tight">{svc.title}</h3>
            <p class="mt-3 text-white/70 text-sm leading-relaxed">{svc.short}</p>
            <ul class="mt-5 space-y-2 border-t border-white/10 pt-5">
              {svc.bullets.slice(0, 4).map(b => (
                <li class="flex gap-2.5 text-sm text-white/75">
                  <span class="text-orange-400 mt-1">▸</span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== APPROACH =========================== -->
  <section id="approach" class="relative py-16 md:py-32 bg-navy-50 overflow-hidden">
    <!-- Subtle blueprint background -->
    <div class="absolute inset-0 opacity-[0.08]" style="background-image: url('/img/stock/blueprint-tools.jpg'); background-size: cover; background-position: center;"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-navy-50 via-navy-50/50 to-transparent"></div>

    <div class="container-x relative">
      <div class="max-w-3xl" data-reveal>
        <div class="text-xs uppercase tracking-[0.25em] text-orange-500 font-semibold">Our Approach</div>
        <h2 class="font-display text-4xl md:text-5xl font-extrabold text-navy-900 mt-3 leading-tight text-balance">
          How we deliver every project.
        </h2>
        <p class="mt-4 text-navy-700 text-lg">From first sketch to final commissioning — engineered with BIM, delivered with care.</p>
      </div>

      <div class="mt-10 md:mt-16 grid md:grid-cols-2 lg:grid-cols-4 gap-6" data-stagger>
        {approach.map(a => (
          <div data-shine class="brand-border relative bg-white/80 backdrop-blur-sm rounded-2xl p-7 transition-all duration-300">
            <div class="flex items-start justify-between">
              <div class="text-5xl font-display font-extrabold text-orange-500">{a.n}</div>
              <div class="w-11 h-11 rounded-xl bg-navy-50 ring-1 ring-navy-100 text-navy-700 flex items-center justify-center">
                <Icon name={a.icon} class="w-5 h-5" />
              </div>
            </div>
            <div class="mt-3 h-px w-12 bg-orange-200"></div>
            <h3 class="mt-5 font-display text-xl font-bold text-navy-900">{a.title}</h3>
            <p class="mt-3 text-navy-700 text-sm leading-relaxed">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== WHY US =========================== -->
  <section class="py-16 md:py-32 bg-orange-500 text-white relative overflow-hidden">
    <div class="absolute -bottom-20 -right-20 w-[600px] h-[600px] rounded-full bg-orange-400/40 blur-3xl"></div>

    <div class="container-x relative grid lg:grid-cols-12 gap-10 lg:gap-14 items-center">
      <!-- LEFT: Photo column -->
      <div class="lg:col-span-5" data-reveal>
        <div class="text-xs uppercase tracking-[0.25em] text-white/70 font-semibold">Why us?</div>
        <h2 class="font-display text-5xl md:text-6xl font-extrabold mt-3 leading-[1.05] text-balance">
          Why choose Future Hitech solutions?
        </h2>

        <div class="mt-10 relative">
          <div class="brand-border-3 relative aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl">
            <img src="/img/stock/electrician-cables.jpg" alt="Future Hitech engineer at electrical panel" class="absolute inset-0 w-full h-full object-cover" loading="lazy"/>
            <div class="absolute inset-0 bg-gradient-to-t from-orange-700/60 via-transparent to-transparent"></div>
          </div>
          <!-- Floating stat card -->
          <div class="absolute -bottom-6 -right-6 sm:-right-10 bg-navy-900 text-white rounded-2xl px-6 py-5 shadow-2xl max-w-[220px]">
            <div class="text-4xl font-display font-extrabold text-orange-400">+40</div>
            <div class="text-xs uppercase tracking-wider text-white/70 mt-1">Satisfied customers · zero callbacks</div>
          </div>
        </div>
      </div>

      <!-- RIGHT: Reasons -->
      <div class="lg:col-span-7 space-y-5" data-stagger>
        {whyUs.map(w => (
          <div class="flex gap-5 items-start">
            <div class="flex-none w-12 h-12 rounded-xl bg-white/15 ring-1 ring-white/25 backdrop-blur flex items-center justify-center text-white">
              <Icon name={w.icon} class="w-6 h-6" />
            </div>
            <div class="border-l-2 border-white/40 pl-5 hover:border-navy-900 transition-colors">
              <h3 class="font-display text-2xl font-bold leading-tight">{w.title}</h3>
              <p class="mt-2 text-white/90 leading-relaxed">{w.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== SECTORS =========================== -->
  <section id="sectors" class="py-16 md:py-32 bg-navy-900 text-white">
    <div class="container-x">
      <div class="max-w-3xl" data-reveal>
        <div class="text-xs uppercase tracking-[0.25em] text-orange-400 font-semibold">Sectors We Serve</div>
        <h2 class="font-display text-4xl md:text-5xl font-extrabold mt-3 leading-tight text-balance">
          From luxury apartments to industrial plants.
        </h2>
      </div>

      <div class="mt-10 md:mt-16 grid sm:grid-cols-2 lg:grid-cols-4 gap-6" data-stagger>
        {sectors.map(s => (
          <article class="group brand-border relative overflow-hidden rounded-3xl bg-navy-800 aspect-[3/4]">
            <img src={s.photo} alt={s.title} class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-105 transition-all duration-500" loading="lazy" onerror="this.style.display='none'"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900 via-navy-900/60 to-transparent"></div>
            <!-- top-right icon badge -->
            <div class="absolute top-4 right-4 w-11 h-11 rounded-xl bg-white/15 backdrop-blur ring-1 ring-white/25 flex items-center justify-center text-white">
              <Icon name={s.icon} class="w-5 h-5" />
            </div>
            <div class="relative h-full flex flex-col justify-end p-6">
              <div class="inline-flex w-fit rounded-full bg-orange-500 px-3 py-1 text-xs font-bold uppercase tracking-wider mb-3">{s.title}</div>
              <ul class="space-y-1 text-sm text-white/90">
                {s.items.map(i => <li>· {i}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== PROJECTS =========================== -->
  <section id="projects" class="py-16 md:py-32 bg-white">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6 max-w-5xl" data-reveal>
        <div>
          <div class="text-xs uppercase tracking-[0.25em] text-orange-500 font-semibold">Our Projects</div>
          <h2 class="font-display text-4xl md:text-5xl font-extrabold text-navy-900 mt-3 leading-tight text-balance">
            A glimpse of recent work.
          </h2>
        </div>
        <p class="text-navy-700 max-w-md">Residential interiors, commercial fit-outs, and electrical infrastructure delivered across the UAE.</p>
      </div>

      <div id="gallery-grid" class="mt-16 grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3" data-stagger>
        {projects.map((p, i) => (
          <button
            type="button"
            data-gallery-open
            data-index={i}
            class="group brand-border relative aspect-square overflow-hidden rounded-xl bg-navy-100 cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-orange-500"
            aria-label={`Open project ${p.n}`}
          >
            <img src={p.src} alt={p.alt} loading="lazy" class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.parentElement.style.display='none'"/>
            <div class="absolute inset-0 bg-gradient-to-t from-navy-900/80 via-navy-900/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
            <!-- Number badge -->
            <div class="absolute top-2 left-2 rounded-full bg-orange-500 text-white text-[10px] font-bold w-7 h-7 flex items-center justify-center opacity-0 group-hover:opacity-100 group-hover:translate-y-0 -translate-y-1 transition-all duration-300">{p.n}</div>
            <!-- Zoom hint -->
            <div class="absolute bottom-3 right-3 w-9 h-9 rounded-full bg-white text-navy-900 flex items-center justify-center opacity-0 group-hover:opacity-100 scale-75 group-hover:scale-100 transition-all duration-300 shadow-lg">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/><path d="M11 8v6M8 11h6"/>
              </svg>
            </div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- =========================== LIGHTBOX =========================== -->
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden items-center justify-center p-4 sm:p-8 bg-navy-950/95 backdrop-blur-md opacity-0 transition-opacity duration-300"
    role="dialog"
    aria-modal="true"
    aria-label="Project gallery"
  >
    <!-- Counter (top center) -->
    <div class="absolute top-4 left-1/2 -translate-x-1/2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur ring-1 ring-white/15 text-white text-xs font-semibold tracking-wider">
      <span id="lightbox-counter">1 / 17</span>
    </div>

    <!-- Close (top-right) -->
    <button
      type="button"
      id="lightbox-close"
      class="absolute top-4 right-4 w-11 h-11 rounded-full bg-white/10 hover:bg-orange-500 backdrop-blur ring-1 ring-white/15 text-white flex items-center justify-center transition-colors"
      aria-label="Close gallery"
    >
      <Icon name="x" class="w-5 h-5" />
    </button>

    <!-- Prev -->
    <button
      type="button"
      id="lightbox-prev"
      class="absolute left-2 sm:left-6 top-1/2 -translate-y-1/2 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-white/10 hover:bg-orange-500 backdrop-blur ring-1 ring-white/15 text-white flex items-center justify-center transition-colors"
      aria-label="Previous photo"
    >
      <Icon name="chevron-left" class="w-6 h-6" />
    </button>

    <!-- Next -->
    <button
      type="button"
      id="lightbox-next"
      class="absolute right-2 sm:right-6 top-1/2 -translate-y-1/2 w-12 h-12 sm:w-14 sm:h-14 rounded-full bg-white/10 hover:bg-orange-500 backdrop-blur ring-1 ring-white/15 text-white flex items-center justify-center transition-colors"
      aria-label="Next photo"
    >
      <Icon name="chevron-right" class="w-6 h-6" />
    </button>

    <!-- Image stage -->
    <figure class="relative max-w-5xl max-h-[80vh] w-full">
      <img
        id="lightbox-img"
        src=""
        alt=""
        class="block max-h-[80vh] w-full object-contain rounded-2xl shadow-2xl transition-all duration-300"
      />
      <figcaption
        id="lightbox-caption"
        class="mt-4 text-center text-white/80 text-sm"
      >
      </figcaption>
    </figure>

    <!-- Thumbnail strip -->
    <div class="absolute bottom-4 left-1/2 -translate-x-1/2 max-w-[90vw] overflow-x-auto">
      <div id="lightbox-thumbs" class="flex gap-2 px-3 py-2 rounded-2xl bg-white/5 ring-1 ring-white/10 backdrop-blur">
        {projects.map((p, i) => (
          <button
            type="button"
            data-thumb-index={i}
            class="lb-thumb flex-none w-10 h-10 sm:w-12 sm:h-12 rounded-md overflow-hidden ring-2 ring-transparent hover:ring-orange-400 transition-all opacity-50 hover:opacity-100"
            aria-label={`Jump to photo ${p.n}`}
          >
            <img src={p.src} alt="" loading="lazy" class="w-full h-full object-cover"/>
          </button>
        ))}
      </div>
    </div>
  </div>

  <script define:vars={{ projects }}>
    (function () {
      const lb        = document.getElementById('lightbox');
      const lbImg     = document.getElementById('lightbox-img');
      const lbCap     = document.getElementById('lightbox-caption');
      const lbCount   = document.getElementById('lightbox-counter');
      const lbThumbs  = document.querySelectorAll('.lb-thumb');
      const btnClose  = document.getElementById('lightbox-close');
      const btnPrev   = document.getElementById('lightbox-prev');
      const btnNext   = document.getElementById('lightbox-next');
      const triggers  = document.querySelectorAll('[data-gallery-open]');

      let current = 0;
      const total = projects.length;

      function show(i) {
        current = ((i % total) + total) % total;
        const p = projects[current];
        // Fade out image briefly for smooth swap
        lbImg.style.opacity = '0';
        const next = new Image();
        next.onload = () => {
          lbImg.src = next.src;
          lbImg.alt = p.alt || '';
          lbImg.style.opacity = '1';
        };
        next.src = p.src;
        lbCap.textContent = `Project ${p.n} — Future Hitech`;
        lbCount.textContent = `${current + 1} / ${total}`;
        // Update active thumb
        lbThumbs.forEach((t, idx) => {
          if (idx === current) {
            t.classList.add('ring-orange-400', 'opacity-100');
            t.classList.remove('opacity-50');
            t.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
          } else {
            t.classList.remove('ring-orange-400', 'opacity-100');
            t.classList.add('opacity-50');
          }
        });
      }

      function open(i) {
        show(i);
        lb.classList.remove('hidden');
        lb.classList.add('flex');
        // force reflow then animate in
        void lb.offsetWidth;
        lb.style.opacity = '1';
        document.body.style.overflow = 'hidden';
      }

      function close() {
        lb.style.opacity = '0';
        setTimeout(() => {
          lb.classList.add('hidden');
          lb.classList.remove('flex');
          document.body.style.overflow = '';
        }, 250);
      }

      triggers.forEach((t) => {
        t.addEventListener('click', () => open(parseInt(t.dataset.index, 10)));
      });
      lbThumbs.forEach((t) => {
        t.addEventListener('click', () => show(parseInt(t.dataset.thumbIndex, 10)));
      });
      btnClose.addEventListener('click', close);
      btnPrev.addEventListener('click', () => show(current - 1));
      btnNext.addEventListener('click', () => show(current + 1));

      // Click on backdrop (but not the figure or buttons) closes
      lb.addEventListener('click', (e) => {
        if (e.target === lb) close();
      });

      // Keyboard
      document.addEventListener('keydown', (e) => {
        if (lb.classList.contains('hidden')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') show(current - 1);
        if (e.key === 'ArrowRight') show(current + 1);
      });

      // Touch swipe
      let touchStartX = 0;
      lb.addEventListener('touchstart', (e) => { touchStartX = e.touches[0].clientX; }, { passive: true });
      lb.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      });
    })();
  </script>

